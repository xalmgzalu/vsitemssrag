# Gemini API
GEMINI_API_KEY=
# Optional override; default: gemini-3.5-flash-lite
GEMINI_GENERATION_MODEL=

# Supabase PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres

# Telegram pilot (create a bot via @BotFather; never commit the token)
TELEGRAM_BOT_TOKEN=
# Optional override; bot defaults to data/exports/review_enrichment_pilot_v2.json
RAG_EVIDENCE_FILE=
